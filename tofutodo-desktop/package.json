{
    "name": "tofutodo-desktop",
    "version": "1.0.0",
    "description": "Desktop widget for TofuTodo",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win nsis --x64"
    },
    "build": {
        "appId": "com.dogeleven.tofutodo",
        "productName": "TofuTodo-Widget",
        "artifactName": "TofuTodo-Widget-Setup.${ext}",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "package.json"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "TofuTodo Widget",
            "uninstallDisplayName": "TofuTodo Widget"
        }
    },
    "devDependencies": {
        "electron": "^28.2.0",
        "electron-builder": "^24.9.1",
        "electron-packager": "^17.1.2"
    }
}
