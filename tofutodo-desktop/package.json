{
    "name": "tofutodo-desktop",
    "version": "1.2.3",
    "description": "Desktop widget for TofuTodo",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win nsis --x64"
    },
    "build": {
        "appId": "com.dogeleven.tofutodo",
        "productName": "TofuTodo-Widget",
        "artifactName": "TofuTodo-Widget-Setup.${ext}",
        "afterPack": "build/afterPack.js",
        "publish": [
            {
                "provider": "generic",
                "url": "https://dogeleven.github.io/test/"
            }
        ],
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "package.json",
            "build/tray.png"
        ],
        "win": {
            "signAndEditExecutable": false,
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "TofuTodo Widget",
            "uninstallDisplayName": "TofuTodo Widget",
            "installerIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico",
            "installerHeaderIcon": "build/icon.ico"
        }
    },
    "devDependencies": {
        "electron": "^28.2.0",
        "electron-builder": "^24.9.1",
        "electron-packager": "^17.1.2"
    },
    "dependencies": {
        "electron-updater": "^6.6.2"
    }
}
